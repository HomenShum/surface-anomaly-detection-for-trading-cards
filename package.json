{
  "name": "card-condition-vault",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first trading card condition catalog, DING detector, and timestamped evidence vault.",
  "scripts": {
    "dev": "pnpm --filter @card-condition-vault/web dev",
    "dev:web": "pnpm --filter @card-condition-vault/web dev",
    "dev:api": "python -m uvicorn app.main:app --app-dir services/inference-api",
    "dev:api:reload": "python -m uvicorn app.main:app --reload --app-dir services/inference-api",
    "build": "pnpm --filter @card-condition-vault/web build",
    "lint": "pnpm --filter @card-condition-vault/web lint",
    "test": "pnpm test:api && pnpm test:web && pnpm test:evolution && pnpm test:methods && pnpm test:certrefs && pnpm test:agentic-certrefs && pnpm test:showcase",
    "test:api": "python -m pytest",
    "test:web": "pnpm --filter @card-condition-vault/web test",
    "test:e2e": "playwright test",
    "test:evolution": "tsx scripts/qa/inspection_skill_evolution_check.ts --check",
    "test:methods": "node scripts/qa/verify_method_registry.mjs",
    "test:certrefs": "node scripts/eval/eval_certrefs.mjs --check",
    "test:agentic-certrefs": "node scripts/eval/agentic_cert_eval_runner.mjs --check",
    "test:showcase": "python scripts/showcase/build_showcase_packet.py",
    "demo:seed": "python scripts/demo/seed_card_condition_vault.py",
    "dogfood": "pnpm test:e2e && python scripts/qa/snapshot_report.py && python scripts/showcase/build_showcase_packet.py",
    "demo:gifs": "node scripts/demo/record_shareable_flows.mjs",
    "demo:gifs:real-ding": "python scripts/demo/build_real_ding_annotation_gif.py",
    "demo:gifs:workspace": "node scripts/demo/record_workspace_flow.mjs",
    "demo:gifs:scan": "node scripts/demo/record_scan_flow.mjs",
    "demo:readme": "python scripts/qa/build_submission_package.py",
    "demo:submission": "python scripts/qa/build_submission_package.py",
    "qa:snapshots": "python scripts/qa/snapshot_report.py",
    "qa:evolution": "tsx scripts/qa/inspection_skill_evolution_check.ts",
    "qa:methods": "node scripts/qa/verify_method_registry.mjs",
    "qa:launch": "node scripts/qa/launch_blocker_check.mjs",
    "certrefs:worker": "node scripts/certs/cert_reference_worker.mjs",
    "eval:certrefs": "node scripts/eval/eval_certrefs.mjs",
    "eval:certrefs:bands": "node scripts/eval/eval_cert_band_agreement.mjs",
    "eval:certrefs:run": "node scripts/eval/run_inference_on_slabs.mjs",
    "eval:certrefs:agentic": "node scripts/eval/agentic_cert_eval_runner.mjs",
    "eval:agentic-annotations": "node scripts/eval/eval_agentic_annotations.mjs",
    "eval:certrefs:remote-proof": "node scripts/eval/remote_cert_outcome_proof.mjs",
    "proof:visible-condition": "node scripts/eval/visible_condition_proof.mjs",
    "proof:visible-condition:vendor": "node scripts/eval/visible_condition_proof.mjs --mode=vendor-alpha --strict",
    "eval:production-readiness": "node scripts/eval/production_accuracy_gate.mjs",
    "eval:production-readiness:strict": "node scripts/eval/production_accuracy_gate.mjs --strict",
    "gate:demo": "node scripts/eval/production_accuracy_gate.mjs --check --mode=demo --strict",
    "gate:alpha": "node scripts/eval/production_accuracy_gate.mjs --check --mode=certified_reference_alpha --strict",
    "gate:production": "node scripts/eval/production_accuracy_gate.mjs --check --mode=production --strict",
    "eval:certrefs:snapshot": "node scripts/eval/snapshot_cert_eval_baseline.mjs",
    "flywheel:run": "node scripts/eval/agentic_cert_flywheel.mjs",
    "flywheel:loop": "node scripts/eval/agentic_cert_flywheel.mjs --loop=3",
    "flywheel:full": "node scripts/eval/full_system_flywheel.mjs",
    "flywheel:full:train-smoke": "node scripts/eval/full_system_flywheel.mjs --train-smoke",
    "certs:extract-candidates": "node scripts/certs/extract_psa_candidates_from_images.mjs",
    "certs:verify-candidates": "node scripts/certs/verify_psa_cert_candidates.mjs",
    "certs:materialize-images": "node scripts/certs/materialize_vendor_slab_images.mjs",
    "certs:build-imports": "node scripts/certs/build_cert_reference_seed.mjs",
    "certs:detect-labels": "python scripts/certs/detect_psa_labels.py",
    "certs:resolve-identities": "node scripts/certs/resolve_card_identities.mjs",
    "qa:dealer:hero": "node scripts/qa/dogfood_dealer_hero.mjs",
    "demo:laptop:check": "node scripts/qa/launch_blocker_check.mjs",
    "eval:model": "python ml/scripts/eval_models.py --data ml/datasets/yolo/roboflow_alpha/dataset.yaml --weights services/inference-api/app/models/ding-detector-v0.pt --output ml/runs/eval_yolo_test_report.json --conf 0.25 --iou 0.5",
    "showcase:packet": "python scripts/showcase/build_showcase_packet.py",
    "showcase:remotion:preview": "pnpm --filter @card-condition-vault/showcase-remotion preview",
    "showcase:remotion:render": "pnpm --filter @card-condition-vault/showcase-remotion render"
  },
  "dependencies": {
    "convex": "^1.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.15.0"
}
